# Sử dụng Python 3.10 slim để tối ưu dung lượng và tương thích tốt
FROM python:3.10-slim

# Thiết lập biến môi trường
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_DIR=artifacts/onnx \
    TZ=Asia/Ho_Chi_Minh

WORKDIR /app

# Cài đặt các dependencies hệ thống tối thiểu cần thiết
# build-essential để build một số thư viện python nếu chưa có wheel
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements và cài đặt python packages
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy source code cần thiết cho inference
COPY capy_teacher/ capy_teacher/
COPY shared/ shared/
COPY scripts/ scripts/
COPY api.py .

# Copy model artifacts (ONNX)
# Folder này cần có sẵn (được commit lên git hoặc download trong quá trình build)
COPY artifacts/onnx/ artifacts/onnx/

# Expose port
EXPOSE 8000

# Healthcheck đơn giản
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/docs').getcode() == 200" || exit 1

# Command chạy ứng dụng
CMD ["python", "-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
